# ==========================================
# APPLICATION
# ==========================================

APP_NAME=Personal AI Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==========================================
# SECURITY
# ==========================================

JWT_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# ==========================================
# SUPABASE
# ==========================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=

# ==========================================
# LLM PROVIDER PRIORITY
# ==========================================

LLM_PROVIDER_PRIORITY=groq,openrouter,gemini,openai

# Groq
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=12
GROQ_MAX_OUTPUT_TOKENS=2048

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=15
OPENROUTER_MAX_OUTPUT_TOKENS=2048

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=2048

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=2048

VITE_API_REQUEST_TIMEOUT_MS=65000
LLM_REQUEST_DEADLINE_SECONDS=50

# ==========================================
# GOOGLE OAUTH
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google Picker (Drive contracts MVP). Browser API key restricted to the
# configured frontend origins and the Picker API. Login is still OAuth.
GOOGLE_API_KEY=

# Google Drive contracts (read-only, selected files only)
# Temporarily disabled for production readiness. Intended disabled configuration:
# DRIVE_CONTRACTS_ENABLED=false
# Backend enforcement blocks Drive endpoints/OAuth/workflows/capabilities even if
# an old environment override is true. Do not enable until explicitly re-approved.
DRIVE_CONTRACTS_ENABLED=false
DRIVE_CONTRACTS_MAX_FILES_PER_ANSWER=3
DRIVE_CONTRACTS_MAX_CHARS_PER_DOCUMENT=30000
DRIVE_CONTRACTS_MAX_TOTAL_CHARS=90000
DRIVE_CONTRACTS_MAX_DOWNLOAD_BYTES=20971520

# ==========================================
# FRONTEND
# ==========================================

# Local development frontend
FRONTEND_URL=http://localhost:5173

# Comma-separated origins allowed by FastAPI CORS. This must include the
# production frontend origin used in Render.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.myorbitai.in
BACKEND_URL=http://localhost:8000
