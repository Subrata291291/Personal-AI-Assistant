# ==========================================
# APPLICATION
# ==========================================

APP_NAME=Personal AI Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==========================================
# SECURITY
# ==========================================

JWT_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# ==========================================
# SUPABASE
# ==========================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=

# ==========================================
# LLM PROVIDER PRIORITY
# ==========================================

LLM_PROVIDER_PRIORITY=groq,openrouter,gemini,openai

# Groq
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_OUTPUT_TOKENS=2048

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_OUTPUT_TOKENS=2048

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2048

# ==========================================
# GOOGLE OAUTH
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==========================================
# FRONTEND
# ==========================================

# Local development frontend
FRONTEND_URL=http://localhost:5173

# Comma-separated origins allowed by FastAPI CORS. This must include the
# production frontend origin used in Render.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.myorbitai.in
BACKEND_URL=http://localhost:8000
